#!/usr/bin/env bash
# agenticnotch-notify — poke AgenticNotch from AI CLI agent hooks.
# Usage: agenticnotch-notify --tool claude [--status ok] [--project NAME] [--title TEXT]
#
# Claude Code: point the SessionStart, UserPromptSubmit, Notification, Stop and
# SessionEnd hooks here; hook_event_name / session_id / cwd come from the stdin JSON.
# Codex: `notify` appends its JSON payload (only agent-turn-complete) as the last arg.
#
# Each call opens exactly one URL:
#   - session id known (every Claude hook, Codex thread-id) →
#     agenticnotch://agent-event?tool=&event=<session_start|prompt|waiting|stop|session_end>&session=&project=&detail=
#     which feeds the "needs you" card, the finish card + history (on stop) and the
#     live session list.
#   - no session id (manual run, old setups) → the legacy agenticnotch://done URL;
#     --status only reaches this one.
# On stop it derives a short "what it did" title from the transcript unless --title
# is given. Set AGENTICNOTCH_DEBUG=1 to print the URL instead of opening it (never in
# a real hook: SessionStart/UserPromptSubmit stdout goes into Claude's context).
set -euo pipefail

# Capture stdin (hook JSON) BEFORE anything else consumes it. Guarded so manual
# terminal runs (stdin is a tty) don't block; short timeout for the rest.
hook_json=""
if [ ! -t 0 ]; then
  IFS= read -r -d '' -t 1 hook_json <&0 || true
fi

tool=""; status="ok"; project=""; title=""
while [ $# -gt 0 ]; do
  case "$1" in
    --tool)    tool="${2:-}"; shift 2 ;;
    --status)  status="${2:-}"; shift 2 ;;
    --project) project="${2:-}"; shift 2 ;;
    --title)   title="${2:-}"; shift 2 ;;
    "{"*)      hook_json="${hook_json:-$1}"; shift ;;   # Codex notify payload
    *)         shift ;;
  esac
done

# Hook fields, joined by the unit separator so empty ones survive `read`.
hook_event=""; session=""; cwd=""; message=""; ntype=""
if [ -n "$hook_json" ]; then
  IFS=$'\x1f' read -r hook_event session cwd message ntype < <(HOOK_JSON="$hook_json" python3 -c '
import os, json
try:
    h = json.loads(os.environ["HOOK_JSON"])
except Exception:
    h = {}
h = h if isinstance(h, dict) else {}
def f(*keys):
    return " ".join(str(next((h[k] for k in keys if h.get(k)), "")).split())
print("\x1f".join([f("hook_event_name"), f("session_id", "thread-id"), f("cwd"), f("message"),
                   f("notification_type")]))
' 2>/dev/null) || true
fi

# Claude hook -> contract event. No hook name means Codex or a manual run: a finished turn.
case "$hook_event" in
  SessionStart)     event=session_start ;;
  UserPromptSubmit) event=prompt ;;
  Notification)     event=waiting ;;
  Stop|"")          event=stop ;;
  SessionEnd)       event=session_end ;;
  *)                exit 0 ;;   # a hook we don't map: stay quiet
esac
# auth_success is a Notification too, but nobody is waiting on the user.
if [ "$event" = waiting ] && [ "$ntype" = auth_success ]; then exit 0; fi
[ -n "$project" ] || project="$(basename "${cwd:-$PWD}")"

# Derive a short summary from the hook JSON's transcript (last assistant text).
if [ "$event" = stop ] && [ -z "$title" ] && [ -n "$hook_json" ]; then
  title="$(HOOK_JSON="$hook_json" python3 -c '
import os, json
raw = os.environ.get("HOOK_JSON", "")
out = ""
try:
    hook = json.loads(raw)
    tp = os.path.expanduser(hook.get("transcript_path", "") or "")
    last = ""        # text of the most recent assistant message (may be empty if tool-only)
    last_text = ""   # last assistant message that actually had text (fallback)
    if tp:
        with open(tp) as f:
            for line in f:
                try:
                    m = json.loads(line)
                except Exception:
                    continue
                msg = m.get("message", m)
                if not isinstance(msg, dict) or msg.get("role") != "assistant":
                    continue
                c = msg.get("content")
                if isinstance(c, list):
                    parts = [b.get("text", "") for b in c
                             if isinstance(b, dict) and b.get("type") == "text" and b.get("text")]
                    last = " ".join(parts)
                elif isinstance(c, str):
                    last = c
                else:
                    last = ""
                if last.strip():
                    last_text = last
    # Prefer the final assistant text; fall back to the last non-empty one.
    out = last if last.strip() else last_text
except Exception:
    out = ""
out = " ".join(out.split())
if len(out) > 60:
    out = out[:57].rstrip() + "…"
print(out)
' 2>/dev/null || true)"
fi

# Built in a single python call (UserPromptSubmit blocks the prompt while we run).
url="$(TOOL="$tool" STATUS="$status" PROJECT="$project" TITLE="$title" EVENT="$event" \
       SESSION="$session" MESSAGE="$message" python3 -c '
import os
from urllib.parse import urlencode, quote
e = os.environ
q = lambda d: urlencode(d, quote_via=quote)
if e["SESSION"]:
    detail = {"stop": e["TITLE"], "waiting": e["MESSAGE"]}.get(e["EVENT"], "")
    print("agenticnotch://agent-event?" + q({"tool": e["TOOL"], "event": e["EVENT"],
          "session": e["SESSION"], "project": e["PROJECT"], "detail": detail}))
elif e["EVENT"] == "stop":
    print("agenticnotch://done?" + q({"tool": e["TOOL"], "status": e["STATUS"],
                                      "project": e["PROJECT"], "title": e["TITLE"]}))
')"
[ -n "$url" ] || exit 0   # a non-stop event without a session has nothing to key on

if [ "${AGENTICNOTCH_DEBUG:-}" = "1" ]; then
  echo "$url"
else
  open -g "$url"
fi

#!/usr/bin/env bash
# test-agent-event — run the agenticnotch:// URL parser and live-session self-checks
# without building or launching the app (the project has no test target, and a
# second notch app would fight the installed one).
# Compiles boringNotch/models/AgentEvent.swift + AgentSessionStore.swift with DEBUG
# on and runs AgentActivityInfo / AgentEvent / AgentSession.runSelfCheck().
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

cat > "$tmp/main.swift" <<'SWIFT'
AgentActivityInfo.runSelfCheck()
AgentEvent.runSelfCheck()
print("AgentEvent self-checks passed (waiting / kind=permission|idle / malformed / capped / old done URL)")
AgentSession.runSelfCheck()
print("AgentSession self-checks passed (start→working, permission while working→needs you, idle after stop→ignored, stop→done+expiry, session_end→removed, stale drop)")
SWIFT

swiftc -D DEBUG -Onone -o "$tmp/check" \
  "$root/boringNotch/models/AgentEvent.swift" "$root/boringNotch/models/AgentSessionStore.swift" \
  "$tmp/main.swift"
"$tmp/check"
